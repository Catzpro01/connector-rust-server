{
  "name": "02 - Webhook + Set + Respond (API)",
  "description": "Contoh webhook GET dengan query param, responseMode lastNode — 99% sama dengan n8n asli",
  "nodes": [
    {
      "parameters": {
        "path": "demo",
        "httpMethod": "GET",
        "responseMode": "lastNode",
        "responseData": "firstEntryJson"
